<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TT-16: avisos de recordatorios (Android 13+ lo pide en tiempo de ejecución). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TT-18: permiso de cámara pedido en tiempo de ejecución antes de abrir la cámara.
         Si se declara, Android exige que esté concedido también para TakePicture. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- La cámara no es obligatoria para instalar la app; el archivo se comparte solo
         mediante FileProvider. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Android 11+: permite saber si hay una app de cámara instalada. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".TioTecApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TioTecPreventivo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TioTecPreventivo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TT-18: entrega a la app de cámara una URI temporal para guardar la foto. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>

</manifest>